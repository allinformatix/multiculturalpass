#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
cd /opt/odoo
set -a
# shellcheck source=/dev/null
source secrets/backup.env
set +a
exec 9>/run/lock/odoo-maintenance.lock
flock -n 9 || { echo 'Another maintenance operation is active' >&2; exit 75; }
compose() { docker compose "$@"; }
name={{ name | quote }}
database={{ database | quote }}
stage=/opt/odoo/staging/snapshot
resume=false
cleanup() {
  local rc=$?
  trap - EXIT
  if [[ "$resume" == true ]]; then
    if ! compose start odoo; then rc=1; fi
  fi
  if ((rc)); then
    logger -p daemon.err -t odoo-backup 'Backup/restore failed; inspect systemd journal and application state'
    date -u +%FT%TZ > state/backup-failed
  fi
  exit "$rc"
}
trap cleanup EXIT
backup_snapshot() {
  # Initialization is an explicit one-time operation; never treat auth/network failures as an empty repository.
  restic cat config >/dev/null
  [[ ! -e "$stage" ]] || { echo 'Staging exists; inspect previous failed backup before retrying' >&2; return 1; }
  mkdir -p "$stage"
  if [[ $(compose ps --status running --services odoo) == odoo ]]; then
    resume=true
    compose stop --timeout 120 odoo
  fi
  # Odoo is the sole application writer. External DB writers are unsupported.
  compose exec -T db pg_dump -U postgres -Fc "$database" > "$stage/database.dump"
  compose exec -T db pg_restore --list < "$stage/database.dump" >/dev/null
  cp -a data "$stage/data"
  cp -a config "$stage/config"
  cp -a addons "$stage/addons"
  cp compose.yml "$stage/compose.yml"
  cp -a secrets "$stage/secrets"
  if [[ "$resume" == true ]]; then compose start odoo; resume=false; fi
  (
    cd "$stage"
    # SHA256SUMS is explicitly excluded from the input file list.
    # shellcheck disable=SC2094
    find . -type f ! -name SHA256SUMS -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS
  )
  restic backup "$stage" --host "$name" --tag "$name" --json > state/last-backup.json
  restic check --read-data-subset=5%
  # Forget unneeded snapshots but defer costly pack compaction to deliberate maintenance.
  restic forget --host "$name" --tag "$name" --keep-daily {{ backup_keep_daily }} --keep-weekly {{ backup_keep_weekly }} --keep-monthly {{ backup_keep_monthly }}
  rm -rf -- "$stage"
  date -u +%FT%TZ > state/last-backup-success
  rm -f state/backup-failed
}
case "${1:-}" in
  init)
    [[ "${2:-}" == "$name:init-backup" ]] || { echo 'Exact init-backup confirmation required' >&2; exit 2; }
    restic init;;
  backup) backup_snapshot;;
  snapshots) restic snapshots --host "$name" --tag "$name";;
  verify) restic check --read-data;;
  health)
    [[ -f state/last-backup-success && ! -f state/backup-failed ]] || exit 1
    [[ $(find state/last-backup-success -mmin -2160 -print) ]] || exit 1
    echo 'Backup is successful and younger than 36 hours';;
  restore)
    snapshot="${2:-}"
    [[ "$snapshot" =~ ^[a-f0-9]{64}$ && "${3:-}" == "$name:restore" ]] || { echo 'Exact snapshot ID and restore confirmation required' >&2; exit 2; }
    restore_dir=$(mktemp -d /opt/odoo/staging/restore.XXXXXX)
    restic snapshots --json "$snapshot" > "$restore_dir/snapshots.json"
    python3 - "$restore_dir/snapshots.json" "$name" <<'CHECK'
import json,sys
items=json.load(open(sys.argv[1]))
if len(items)!=1 or sys.argv[2] not in items[0].get('tags',[]):sys.exit('snapshot environment mismatch')
CHECK
    restic restore "$snapshot" --target "$restore_dir" --verify
    source_dir="$restore_dir/opt/odoo/staging/snapshot"
    (cd "$source_dir" && sha256sum --check SHA256SUMS >/dev/null)
    # Refuse cross-environment or different-image restore. Major migration is a separate process.
    python3 - "$source_dir/config/version.json" config/version.json <<'CHECK'
import json,sys
source,current=[json.load(open(p)) for p in sys.argv[1:]]
if source!=current:sys.exit('backup configuration/version differs; use the matching deployment revision')
CHECK
    compose exec -T db pg_restore --list < "$source_dir/database.dump" >/dev/null
    # A verified safety backup is mandatory even when overwriting a newly initialized VM.
    backup_snapshot
    compose stop --timeout 120 odoo
    # No auto-resume after this point: a partial restore must stay offline.
    resume=false
    compose exec -T db dropdb -U postgres --force --if-exists "$database"
    compose exec -T db createdb -U postgres -O odoo "$database"
    compose exec -T db pg_restore -U postgres --exit-on-error --no-owner --role=odoo -d "$database" < "$source_dir/database.dump"
    previous="data.pre-restore.$(date -u +%Y%m%dT%H%M%SZ)"
    mv data "$previous"
    cp -a "$source_dir/data" data
    chown -R 101:101 data
    # Restored addons/config are retained for operator inspection; runtime config is the matching current revision.
    mv addons "addons.pre-restore.$(date -u +%Y%m%dT%H%M%SZ)"
    cp -a "$source_dir/addons" addons
    chown -R 101:101 addons
    compose up -d --force-recreate --wait --wait-timeout 180 odoo
    date -u +%FT%TZ > state/last-restore-success
    echo "Restore complete; retained $previous and $restore_dir for inspection";;
  *) echo 'Usage: odoo-backup init|backup|snapshots|verify|restore ID NAME:restore' >&2; exit 2;;
esac
